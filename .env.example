# ── База даних (Turso / libSQL). Локально можна не задавати: створиться data/konkordia.db
DATABASE_URL=libsql://your-db-name.turso.io
DATABASE_AUTH_TOKEN=

# ── Перший адміністратор адмінки (/admin). Створюється лише якщо в базі ще немає користувачів.
#    Після першого входу змініть пароль у «Профілі» та можна прибрати ці змінні.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Адміністратор

# ── Telegram-бот заявок @konkordiya_bot (сценарій: src/lib/server/bot.ts)
#    Токен — від @BotFather. Секрет вебхука — будь-який рядок від 16 символів: openssl rand -hex 24
#    ID групи «Заявки Конкордія» — надішліть /chatid у групі (бот має бути її учасником).
#    Після зміни цих змінних: node --env-file=.env scripts/telegram-setup.mjs і pm2 restart konkordia
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=

# ── GA4 Measurement Protocol: подія telegram_bot_lead із бота
#    GA4 → Адміністратор → Потоки даних → потік сайту → «Секретні ключі API Measurement Protocol» → Створити
GA4_API_SECRET=

# ── Аналітика (зручніше задавати в адмінці → «Налаштування»; змінні — запасний варіант)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=
